#include "resource.h"
#include <windows.h>

IDI_APPICON ICON "..\\res\\app.ico"

// Common Controls v6 activation context (id 1, RT_MANIFEST 24).
1 24 "..\\res\\app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "sliverwolf233"
            VALUE "FileDescription",  "ICS Generate - iCalendar editor"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ICS_Generate"
            VALUE "LegalCopyright",   ""
            VALUE "OriginalFilename", "ICS_Generate.exe"
            VALUE "ProductName",      "ICS Generate"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
            VALUE "Translation", 0x409, 1200
    END
END
